{
  "name": "@crawlora-org/fotmob",
  "version": "0.1.10",
  "description": "Crawlora FotMob API client with 31 endpoints for leagues, matches, fixtures, teams, players, search, standings, news, and rankings",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=fotmob-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-fotmob/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "fotmob", "fotmob-api", "fotmob-scraper", "fotmob-data", "fotmob-leagues", "fotmob-matches", "fotmob-fixtures", "fotmob-teams", "fotmob-players", "fotmob-search", "fotmob-standings", "fotmob-news", "fotmob-rankings"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-fotmob",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
