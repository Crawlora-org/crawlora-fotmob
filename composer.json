{
  "name": "crawlora/fotmob",
  "description": "Crawlora FotMob API client with 31 endpoints for leagues, matches, fixtures, teams, players, search, standings, news, and rankings",
  "keywords": [
    "crawlora",
    "api-client",
    "sdk",
    "web-scraping",
    "scraping-api",
    "fotmob",
    "fotmob-api",
    "fotmob-scraper",
    "fotmob-data",
    "fotmob-leagues",
    "fotmob-matches",
    "fotmob-fixtures",
    "fotmob-teams",
    "fotmob-players",
    "fotmob-search",
    "fotmob-standings",
    "fotmob-news",
    "fotmob-rankings"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Fotmob\\": "php/src/Crawlora/Fotmob/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Fotmob\\Tests\\": "php/tests/"
    }
  },
  "scripts": {
    "test": "php php/tests/client_test.php"
  },
  "homepage": "https://crawlora.net/?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=fotmob-php-homepage",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-fotmob",
    "docs": "https://crawlora.net/docs?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=fotmob-php-api-docs"
  }
}
